file(READ "${INPUT}" data HEX)
string(LENGTH "${data}" length)
math(EXPR remainder "${length} % 8")
if(NOT remainder EQUAL 0 OR NOT data MATCHES "^03022307")
  message(FATAL_ERROR "Invalid SPIR-V module")
endif()
string(REGEX MATCHALL "........" words "${data}")
set(source "#pragma once\n#include <cstdint>\ninline constexpr uint32_t vulkanShader[] = {\n")
foreach(word IN LISTS words)
  string(SUBSTRING "${word}" 0 2 a)
  string(SUBSTRING "${word}" 2 2 b)
  string(SUBSTRING "${word}" 4 2 c)
  string(SUBSTRING "${word}" 6 2 d)
  string(APPEND source "0x${d}${c}${b}${a},")
endforeach()
string(APPEND source "\n};\n")
file(WRITE "${OUTPUT}" "${source}")
